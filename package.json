{
  "name": "manyfold-app-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers starter pre-wired with Manyfold AI-agent connectivity: connect agents, chat to verify, then build your app on top.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "remotion": "remotion studio src/remotion/index.ts",
    "build": "tsc -b && vite build",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@remotion/media-utils": "^4.0.509",
    "@remotion/player": "^4.0.509",
    "hono": "^4.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.509",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@remotion/cli": "^4.0.509",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "cloudflare": {
    "label": "Manyfold Agent Starter",
    "products": [
      "Workers",
      "D1"
    ],
    "bindings": {
      "DB": {
        "description": "Stores connected agents (tokens encrypted at rest), connect sessions, and chat history. Yours to extend."
      }
    }
  }
}
